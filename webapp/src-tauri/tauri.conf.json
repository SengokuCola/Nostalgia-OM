{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LookLab",
  "version": "0.2.0",
  "identifier": "com.sengokucola.nostalgia.looklab",
  "build": {
    "beforeBuildCommand": "npm run build:tauri",
    "frontendDist": "../dist-tauri",
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 5173 --strictPort",
    "devUrl": "http://127.0.0.1:5173"
  },
  "app": {
    "windows": [
      {
        "title": "LookLab · OM-3 暗房工作台",
        "width": 1280,
        "height": 800,
        "minWidth": 420,
        "minHeight": 500,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "Nostalgia-OM",
    "licenseFile": "../public/LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
