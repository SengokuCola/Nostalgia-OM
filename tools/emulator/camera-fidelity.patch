+// Sanitized E147 camera register observations; pixels below are synthetic.
+// No captured photograph, physical timing, AF model or camera-visibility claim.
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {createHash} from 'node:crypto';
+import * as D from '../src/lab/display.mjs';
+import {labEnv} from './lib/env.mjs';
+import {reference} from '../refs/display.mjs';
+const fixture=JSON.parse(readFileSync(new URL('./fixtures/om3-camera-layout.json',import.meta.url)));
+const lab=new D.DisplayLab(labEnv());
+const hash=b=>createHash('sha256').update(b).digest('hex');
+const checks=[];
+try{
+ lab.start();lab.set_gui_buffers();lab.open('tft');lab.palettes();lab.update();lab.assume('A15',true);
+ const ch=2,write=(off,v)=>lab.call(0x501f0dfc,{d0:ch,d1:off/4,a0:v>>>0},null,[0x80,4]);
+ const rows=Array.from({length:600},(_,y)=>Uint8Array.from({length:1600},(_,x)=>x%4===1?100:x%4===3?150:16+(x+y)%220));
+ const snapshot=fixture.registers.map(x=>parseInt(x,16));
+ for(const address of fixture.addresses){
+  const base=parseInt(address,16)*16,source=base+100;
+  lab.bus_rows(source,11136,1600,600,rows);
+  fixture.offsets.forEach((off,i)=>write(off,i===1?parseInt(address,16):snapshot[i]));
+  write(0x620,0x100);lab.vsc.set_view(ch,1);
+  const attach=()=>lab.img_attach.set(ch,{regs:lab.img_steps(ch),src:[800,600],base:source,stride:11136,path:'camera-fixture'});
+  attach();const c=lab.compose('tft');
+  assert.deepEqual(c.errors,[]);assert(c.header.drawn&1);
+  const x0=148-c.header.ox,y0=8-c.header.oy;
+  for(let y=0;y<600;y++)for(let x=0;x<800;x++){
+   const row=rows[y],pair=(x>>1)*4;
+   const want=(row[pair+3]<<16)|(row[pair+1]<<8)|row[pair+(x%2)*2];
+   assert.equal(c.words[(y+y0)*c.header.width+x+x0],want,`pixel ${x},${y}`);
+  }
+  const dump=lab.dump('tft');
+  const ref=reference(ch,dump.mirror,dump.palette,dump.palette_written,(a,n)=>lab.bus_read(a,n),['IMG1'],null,['A15']);
+  assert.deepEqual(c.words,Array.from(ref[2]));
+  assert.deepEqual(lab.bus_rows(source,11136,1600,600).map(hash),rows.map(hash));
+  checks.push('camera-aligned-'+address);
+  // Old consistent-low-bits form must remain equivalent.
+  write(0x390,(base+96)/16);attach();const legacy=lab.compose('tft');assert.deepEqual(legacy.errors,[]);assert.deepEqual(c.words,legacy.words);
+  write(0x390,base/16);attach();checks.push('legacy-equivalence-'+address);
+  for(const [off,value,error] of [[0x3d8,51,'SPOS_UNMODELLED'],[0x3d8,64,'SPOS_UNMODELLED'],[0x390,base/16+1,'SPOS_UNMODELLED'],[0x3c0,8,'DMABN_SHORT'],[0x400,3,'FMT_UNMODELLED']]){
+   const old=lab.sim.u32((0x9bb80000+ch*0x8000+off)>>>0);write(off,value);attach();
+   const bad=lab.compose('tft');assert(bad.errors.some(e=>e.name===error),JSON.stringify(bad.errors));assert(!(bad.header.drawn&1));
+   write(off,old);attach();checks.push('refusal-'+error);
+  }
+ }
+ console.log(JSON.stringify({checks:checks.length,passed:checks,evidence:'register layout observed; synthetic pixels; address interpretation is an inference, not optical validation'}));
+}finally{lab.close();}
\ No newline at end of file
